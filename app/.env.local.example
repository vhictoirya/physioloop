# PhysioLoop · Physio Dashboard — environment variables
# Copy to .env.local and fill in your values

# ─── Solana ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# ─── Torque ───────────────────────────────────────────────────────────────────
# API key from app.torque.so — kept server-side only (not NEXT_PUBLIC_)
TORQUE_API_KEY=your_torque_api_key_here

# Optional: override Torque API base URL
# NEXT_PUBLIC_TORQUE_API_URL=https://api.torque.so

# Campaign IDs — create campaigns in the Torque dashboard and paste IDs here
# Leaving blank disables that campaign; events still fire for analytics
NEXT_PUBLIC_TORQUE_CAMPAIGN_ONBOARDING=    # "First Rep Gift" campaign ID
NEXT_PUBLIC_TORQUE_CAMPAIGN_STREAK=        # "7-Session Streak Rebate" campaign ID
NEXT_PUBLIC_TORQUE_CAMPAIGN_RAFFLE=        # "Plan Completion Raffle" campaign ID
NEXT_PUBLIC_TORQUE_CAMPAIGN_LEADERBOARD=   # "Physio Leaderboard" campaign ID

# ─── Patient app (Expo) ───────────────────────────────────────────────────────
# EXPO_PUBLIC_DASHBOARD_URL — base URL of this Next.js app, so the patient app
# can POST Torque events through the /api/torque/event proxy
# Example: https://physioloop.vercel.app  or  http://192.168.1.x:3000 for LAN testing
EXPO_PUBLIC_DASHBOARD_URL=http://localhost:3000
